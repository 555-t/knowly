<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Post_details_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/light_wallpaper">

    <View
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:background="@drawable/gradient_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="44dp"
        android:background="@null"
        android:contentDescription="go back to home page"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_arrow"
        app:tint="#FDFDFD" />

    <TextView
        android:id="@+id/Activityname"
        android:layout_width="215dp"
        android:layout_height="43dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/inter_bold"
        android:text="Post"
        android:textColor="#FCF5FD"
        android:textSize="30sp"
        app:layout_constraintStart_toEndOf="@+id/backButton"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/includedPostCard"
        layout="@layout/item_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="120dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"

        app:layout_constraintTop_toTopOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCommentsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/includedPostCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Scrollable form"
            android:fillViewport="true"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Comments (1)"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/profilepic"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardCornerRadius="25dp"
                    android:layout_margin="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView2">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_button">

                        <TextView
                            android:id="@+id/user_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="S"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.516"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <EditText
                    android:id="@+id/CommentInput"
                    android:layout_width="259dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="64dp"
                    android:background="@drawable/input_box"
                    android:ems="10"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="start|top"
                    android:hint="Write a comment..."
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    app:layout_constraintStart_toEndOf="@+id/profilepic"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCommentButton"
                    android:layout_width="110dp"
                    android:layout_height="35dp"

                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"

                    app:layout_constraintTop_toBottomOf="@+id/CommentInput"
                    app:layout_constraintStart_toStartOf="@+id/CommentInput"
                    android:layout_marginTop="12dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSubmitComment"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_button"
                        android:backgroundTint="@null"
                        android:fontFamily="@font/inter_medium"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Comment"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/imgMikeAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardCornerRadius="25dp"
                    android:layout_margin="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardCommentButton">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_button">

                        <TextView
                            android:id="@+id/user_profile_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="M"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.516"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutCommentBubble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp"

                    android:background="@drawable/comment_bubble"
                    android:backgroundTint="@null"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginRight="12dp"
                    android:paddingLeft="16dp"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@+id/imgMikeAvatar"
                    app:layout_constraintTop_toTopOf="@+id/imgMikeAvatar">

                    <TextView
                        android:id="@+id/tvCommentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="mike_jones"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvCommentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="2h ago"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tvCommentName"
                        app:layout_constraintStart_toEndOf="@+id/tvCommentName" />

                    <TextView
                        android:id="@+id/tvCommentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter"
                        android:text="Great explanation! Can you share more resources?"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvCommentName" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>