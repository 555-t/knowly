<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_colour"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_colour"
        android:supportsRtl="true"
        android:theme="@style/Theme.Knowly">

        <!-- SplashActivity is now the launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Knowly"/>

        <!-- signup screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true" />

        <!-- Keep MainActivity if you need it later -->
        <activity
            android:name=".HomePage"
            android:exported="true" />

        <activity android:name=".ChooseInterestsActivity"
            android:exported="true" />

        <activity
            android:name=".WeeklyFeaturedActivity"
            android:exported="false" />
        <activity
            android:name=".UserPageActivity"
            android:exported="false" />
        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationActivity"
            android:exported="false" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity android:name=".CreatePostActivity" />


    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
